    most_likely 3p
    pessimistic 5p
  status planned

gate SEARCH_CANDIDATE CANDIDATE_DONE -> SEARCH_READY:
  reason "readはcandidateの公開APIを使う"

gate SEARCH_ASSOCIATION ASSOCIATION_DONE -> SEARCH_READY:
  reason "readはassociationの公開APIを使う"

task READ SEARCH_READY -> READ_DONE:
  title "read module"
  description "記録・関係のID取得・一覧・検索を実装・単独検証する。"
  estimate:
    optimistic 2p
    most_likely 3p
    pessimistic 5p
  status planned

gate ASSEMBLE_BODY BODY_DONE -> MODULES_READY:
  reason "CLI実接続にBODY公開APIを使う"

gate ASSEMBLE_EMBED EMBED_DONE -> MODULES_READY:
  reason "CLI実接続にEMBED公開APIを使う"

gate ASSEMBLE_RELATION RELATION_DONE -> MODULES_READY:
  reason "CLI実接続にRELATION公開APIを使う"

gate ASSEMBLE_REFERENCE REFERENCE_DONE -> MODULES_READY:
  reason "CLI実接続にREFERENCE公開APIを使う"

gate ASSEMBLE_LEDGER LEDGER_DONE -> MODULES_READY:
  reason "CLI実接続にLEDGER公開APIを使う"

gate ASSEMBLE_CANDIDATE CANDIDATE_DONE -> MODULES_READY:
  reason "CLI実接続にCANDIDATE公開APIを使う"

gate ASSEMBLE_ASSOCIATION ASSOCIATION_DONE -> MODULES_READY:
  reason "CLI実接続にASSOCIATION公開APIを使う"

gate ASSEMBLE_RECORD RECORD_DONE -> MODULES_READY:
  reason "CLI実接続にRECORD公開APIを使う"

gate ASSEMBLE_MEMBERSHIP MEMBERSHIP_DONE -> MODULES_READY:
  reason "CLI実接続にMEMBERSHIP公開APIを使う"

gate ASSEMBLE_READ READ_DONE -> MODULES_READY:
  reason "CLI実接続にREAD公開APIを使う"

gate ASSEMBLE_CLI_SURFACE CLI_SURFACE_DONE -> MODULES_READY:
  reason "CLI実接続に入出力目録を使う"

task CLI_WIRING MODULES_READY -> CLI_WIRED:
  title "CLI実接続"
  description "CLIの公開操作を下位moduleの実装とworker入口へ接続する。"
  estimate:
    optimistic 2p
    most_likely 3p
    pessimistic 5p
  status planned

task INTEGRATION_VERIFY CLI_WIRED -> CAPABILITY_VERIFIED:
  title "Accepted受入例と結合境界を検証"
  description "一時XDGの実CLI/workerでAccepted要件の例1〜7、失敗・競合・再開を検証する。"
  estimate:
    optimistic 3p
    most_likely 5p
    pessimistic 8p
  status planned

gate SEAL_DESIGN_BEFORE_SOURCE DESIGN_SEALED -> SOURCE_SEALED:
  reason "source/testのCause先となる設計Sealが必要"

task SEAL_SOURCE CAPABILITY_VERIFIED -> SOURCE_SEALED:
  title "新規ソース・テストの由来を登録"
  description "維持対象のGo module・CLI・テストのREFを登録し、Causeとstaleを点検する。"
  estimate:
    optimistic 1p
    most_likely 2p
    pessimistic 4p
  status planned

gate READY_VERIFIED CAPABILITY_VERIFIED -> PRODUCT_READY:
  reason "Accepted機能の実能力検証が必要"

gate READY_DOCS DOCS_DONE -> PRODUCT_READY:
  reason "現行利用者向け文書が必要"

gate READY_SOURCE SOURCE_SEALED -> PRODUCT_READY:
  reason "維持対象ソースの由来が必要"

